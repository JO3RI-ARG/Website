{
 "areas": {
  "menu": "#nav",
  "site": "#header, #copyright, [data-se-role~=\"social\"]",
  "noDrop": "#nav, #header, #copyright"
 },
 "view": {
  "removeBodyClass": [
   "is-preload"
  ],
  "inject": [
   {
    "into": "#wrapper",
    "html": "<div class=\"bg\"></div>"
   }
  ]
 },
 "menu": {
  "activeClass": "active"
 },
 "credit": {
  "url": "https://html5up.net",
  "name": "HTML5 UP"
 },
 "site": {
  "name": "JO3RI",
  "copyright": "2026 JO3RI",
  "credit": "Template by",
  "background": "",
  "social": {
   "github": "https://github.com/"
  }
 },
 "shared": {
  "header": "\n\t\t\t<header id=\"header\">\n\t\t\t\t<a href=\"index.html\" class=\"logo\">{{name}}</a>\n\t\t\t</header>\n",
  "social": "\n\t\t\t\t<ul class=\"icons\">\n{{items}}\t\t\t\t</ul>\n",
  "socialItem": "\t\t\t\t\t<li><a href=\"{{url}}\" class=\"icon {{icon}}\"><span class=\"label\">{{label}}</span></a></li>\n",
  "copyright": "\n\t\t\t<div id=\"copyright\">\n\t\t\t\t<ul><li>&copy; {{copyright}}</li><li>{{credit}} <a href=\"https://html5up.net\">HTML5 UP</a></li></ul>\n\t\t\t</div>\n"
 },
 "background": {
  "file": "assets/css/site.css",
  "css": "#wrapper > .bg {\n\tbackground-image: url(\"../../images/overlay.png\"), linear-gradient(0deg, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url(\"../../{{path}}\");\n}\n"
 },
 "elements": {
  "title": "<h2>New title</h2>",
  "text": "<p>Write your text here.</p>",
  "image": "<div class=\"image fit\"><img src=\"{{placeholder}}\" alt=\"\" /></div>",
  "imagetext": "<div class=\"row gtr-uniform\" data-se=\"cols\"><div class=\"col-6 col-12-small\" data-se=\"col\"><div class=\"image fit\"><img src=\"{{placeholder}}\" alt=\"\" /></div></div><div class=\"col-6 col-12-small\" data-se=\"col\"><h3>Title</h3><p>Write your text here.</p></div></div>",
  "button": "<ul class=\"actions special\"><li><a href=\"index.html\" class=\"button\">Button text</a></li></ul>",
  "columns2": "<div class=\"row gtr-uniform\" data-se=\"cols\"><div class=\"col-6 col-12-small\" data-se=\"col\"><p>Left column</p></div><div class=\"col-6 col-12-small\" data-se=\"col\"><p>Right column</p></div></div>",
  "columns3": "<div class=\"row gtr-uniform\" data-se=\"cols\"><div class=\"col-4 col-12-small\" data-se=\"col\"><p>Column one</p></div><div class=\"col-4 col-12-small\" data-se=\"col\"><p>Column two</p></div><div class=\"col-4 col-12-small\" data-se=\"col\"><p>Column three</p></div></div>",
  "spacer": "<div class=\"se-spacer\" style=\"height: 40px;\"></div>",
  "divider": "<hr />",
  "embed": "<div class=\"se-embed\"><p>Embed code: paste your HTML in the settings panel on the right.</p></div>",
  "section": "<section class=\"post\" data-se=\"section blocks\"><h2>New section</h2><p>Write your text here.</p></section>"
 },
 "columns": {
  "class": "col-{n} col-12-small"
 },
 "newPage": {
  "remove": [
   "#intro"
  ],
  "removeClass": [
   [
    "#wrapper",
    "fade-in"
   ]
  ],
  "main": "\t\t\t\t<section class=\"post\" data-se=\"section blocks\">\n\t\t\t\t\t<header class=\"major\">\n\t\t\t\t\t\t<h1>{{title}}</h1>\n\t\t\t\t\t</header>\n\t\t\t\t\t<p>Write your text here.</p>\n\t\t\t\t</section>\n"
 },
 "project": {
  "listPage": "index.html",
  "list": "projects",
  "card": "\t\t\t\t\t<article data-se-type=\"project\" data-se-date=\"{{date}}\" data-se-github=\"{{github}}\">\n\t\t\t\t\t\t<header>\n\t\t\t\t\t\t\t<span class=\"date\">{{date}}</span>\n\t\t\t\t\t\t\t<h2><a href=\"{{page}}\">{{title}}</a></h2>\n\t\t\t\t\t\t</header>\n\t\t\t\t\t\t<a href=\"{{page}}\" class=\"image fit\"><img src=\"{{image}}\" alt=\"{{title}}\" /></a>\n\t\t\t\t\t\t<p>{{text}}</p>\n\t\t\t\t\t\t<ul class=\"actions special\">\n\t\t\t\t\t\t\t<li><a href=\"{{page}}\" class=\"button\">Read more</a></li>\n<!--se:if github-->\t\t\t\t\t\t\t<li><a href=\"{{github}}\" class=\"button icon brands fa-github\">GitHub</a></li>\n<!--/se:if-->\t\t\t\t\t\t</ul>\n\t\t\t\t\t</article>\n",
  "page": "\t\t\t\t<section class=\"post\" data-se=\"section blocks\">\n\t\t\t\t\t<header class=\"major\">\n\t\t\t\t\t\t<span class=\"date\">{{date}}</span>\n\t\t\t\t\t\t<h1>{{title}}</h1>\n\t\t\t\t\t\t<p>{{text}}</p>\n\t\t\t\t\t</header>\n\t\t\t\t\t<div class=\"image main\"><img src=\"{{image}}\" alt=\"{{title}}\" /></div>\n\t\t\t\t\t<h2>What it does</h2>\n\t\t\t\t\t<p>Describe the project: what problem it solves and how it works.</p>\n\t\t\t\t\t<h2>Parts</h2>\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>First part</li>\n\t\t\t\t\t\t<li>Second part</li>\n\t\t\t\t\t</ul>\n\t\t\t\t\t<h2>How I built it</h2>\n\t\t\t\t\t<p>The steps, the mistakes and what you would do differently.</p>\n<!--se:if github-->\t\t\t\t\t<ul class=\"actions special\">\n\t\t\t\t\t\t<li><a href=\"{{github}}\" class=\"button large icon brands fa-github\">Code on GitHub</a></li>\n\t\t\t\t\t</ul>\n<!--/se:if-->\t\t\t\t</section>\n"
 },
 "starters": {
  "home": "index.html",
  "page": "about.html"
 },
 "theme": {
  "id": "massively",
  "name": "Massively",
